# ===== LLM（design §16.3：模型 deepseek-v4-flash）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 基础设施适配层（本地 MVP：memory/sqlite；生产：kafka/postgres/redis）=====
AGENTFLOW_STATE_STORE=sqlite        # sqlite | memory | postgres
AGENTFLOW_STATE_DB_PATH=data/agentflow.db
AGENTFLOW_POSTGRES_DSN=localhost:5432/agentflow?user=agentflow&password=agentflow
AGENTFLOW_QUEUE=memory              # memory | kafka
AGENTFLOW_LOCK=memory               # memory | redis
AGENTFLOW_REDIS_URL=redis://localhost:6379/0
AGENTFLOW_KAFKA_BOOTSTRAP=localhost:9092

# ===== CORS（控制面 API 前端跨域；逗号分隔的 origin 列表，如 http://localhost:3000,https://ui.example.com）=====
AGENTFLOW_CORS_ORIGINS=*

# ===== 沙箱（M4，本地 opensandbox）=====
OPEN_SANDBOX_DOMAIN=localhost:8080
# OPEN_SANDBOX_API_KEY=

# ===== 观测（可选，MVP 可后置）=====
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 执行模式（§6/§8.6）=====
# inline：API 进程内直接执行（本地 MVP 默认）
# queue ：API 发布 run.trigger/run.command，Worker 消费（memory=进程内 Worker；kafka=独立进程）
# AGENTFLOW_RUN_MODE=queue

# ===== 多租户认证（§9.1）=====
# 非空 = 强制 Bearer JWT（tenant 由 claim tenant_id/org_id 派生，客户端提交忽略）
# 为空 = dev 模式，回退 X-Tenant-ID 头/请求体传参（仅限本地联调）
# AGENTFLOW_JWT_SECRET=change-me
# AGENTFLOW_JWT_ALGORITHM=HS256
# 租户库 db_ref/凭证加密密钥（Fernet 32B urlsafe base64；缺省从 jwt_secret 派生并告警）
# AGENTFLOW_SECRET_KEY=
# 租户配置文件（§9.3 配额/审批人；缺省内置默认不限制）
# AGENTFLOW_TENANTS_FILE=tenants.yaml

# ===== 数据面姿态（v5.3 §7/P1；v5.5 批3 起语义收窄）=====
# 内置共享数据源工具已删除（数据查询全部走租户 MCP），本开关如今只剩一个作用：
# 0（默认，生产加固）：封堵 inputs.repos 直传
# 1（dev/testbed 联调）：允许 inputs.repos（启动告警）
# AGENTFLOW_SHARED_DATASOURCES=0

# ===== 仓库映射（工作区准备，§8.7.2）=====
# 修复侧 agent 要在真实代码工作区里改代码，工作区在 run 创建时克隆。
# 该动作发生在任何 agent 节点之前，拿不到 MCP 的 CMDB，故由部署配置驱动。
# 仓库根：空 = 不做工作区准备（修复侧工具会明确报错）。本地路径自动补 file://。
# AGENTFLOW_REPO_ROOT=
# service → 仓库目录名（JSON）；缺省目录名 = 服务名
# AGENTFLOW_REPO_MAP={"order-service": "aiops-test-order-service", "warranty-service": "aiops-test-warranty-service", "gateway-service": "aiops-test-gateway-service"}

# ===== 配置热载（Worker）=====
# Worker 独立进程看不到 API 的内存状态，按「库内指纹」判定 agent 配置 / MCP server
# 是否变过。本值 = 两次查库检查之间的最小间隔（秒）→ 配置变更最迟在此间隔内生效。
# 0 = 每次节点执行都查（测试用）。
# AGENTFLOW_CONFIG_REFRESH_SEC=5.0

# ===== App Indicators（Smart Inspection 数据面）=====
# ⚠️ 架构例外：这组配置让 agentflow **直连 Prometheus**，与「数据面查询全部走租户
# MCP」的既定姿态相悖（见 CLAUDE.md 关键设计约束 §7 的例外条目）。
# 动因：遗留前端 Smart Inspection 要的是瞬时值 + UI 形状的信封，而 MCP 侧
# `backends/prometheus.py` 是面向 LLM 证据的 query_range（只有 5 个领域指标）。
# TODO(v5.7) 收编进 aiops-datasource-mcp-server 后删除本组配置。
#
# Prometheus 基址（不含 /api/v1）。测试床是 kubectl port-forward 的固定映射。
# AGENTFLOW_PROMETHEUS_URL=http://localhost:19090
# 服务自动发现所用 job：up{job=...} 的 service 标签即服务清单
# AGENTFLOW_PROMETHEUS_JOB=app-metrics
# cAdvisor 指标的 namespace 过滤；空 = 不过滤
# AGENTFLOW_PROMETHEUS_NAMESPACE=order
# 单次查询超时（秒）
# AGENTFLOW_PROMETHEUS_TIMEOUT_SEC=5.0
# 容器活跃判定阈值（秒）：container_last_seen 早于 now-该值 视为已销毁 pod 的陈旧样本
# AGENTFLOW_PROMETHEUS_STALENESS_SEC=60.0
# 快照短缓存（秒）。0 = 禁用。只缓存成功结果，失败不缓存。
# AGENTFLOW_APP_INDICATORS_CACHE_TTL=2.0
# 展示元数据（owner/type/agentName）从 K8s Deployment 的 label 读，约定：
#   aiops/type: sales | aftersales | common       （取值不校验，由使用方约定；
#                                                  页面列头显示为 "Squad"）
#   aiops/owner: <负责人>
#   aiops/agent: <巡检 agent>                      （后端仍返回，前端自 2026-09-16 起不再展示）
# 这些是**声明配置**而非实测值；K8s 读失败只让这三个字段留空 + 记 warning，指标不受影响。
# AGENTFLOW_SERVICE_META_ENABLED=1
# 读 label 的 namespace；空 = 沿用 AGENTFLOW_PROMETHEUS_NAMESPACE
# AGENTFLOW_SERVICE_META_NAMESPACE=
# label 缓存（秒）。Deployment label 极少变，不必每 5 秒轮询都打 K8s API。
# AGENTFLOW_SERVICE_META_CACHE_TTL=60.0

# status 阈值（%）。与前端 metricClass 的 ≥90 红 / ≥70 黄对齐，避免「绿条红徽章」。
# AGENTFLOW_APP_INDICATORS_WARN_CPU=70.0
# AGENTFLOW_APP_INDICATORS_CRIT_CPU=90.0
# AGENTFLOW_APP_INDICATORS_WARN_MEM=70.0
# AGENTFLOW_APP_INDICATORS_CRIT_MEM=90.0
