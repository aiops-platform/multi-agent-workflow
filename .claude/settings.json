{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-push-guard.sh\"",
            "timeout": 30,
            "statusMessage": "检查是否落后远端"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-radius-warn.sh\"",
            "timeout": 15,
            "statusMessage": "检查改动面"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/retro-harvest-check.sh\"",
            "timeout": 10,
            "statusMessage": "检查经验回收"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/codegraph-sync.sh\"",
            "timeout": 10,
            "statusMessage": "同步代码索引"
          }
        ]
      }
    ]
  }
}
